   "source": [
    "daily=[200,150,0,400,50,-1,300]\n",
    "sales=0\n",
    "for amount in daily:\n",
    "    if(amount>0):\n",
    "        sales+=amount\n",
    "        print('Sales=',sales)\n",
    "    elif(amount==0):\n",
    "        continue\n",
    "    elif(amount<0):\n",
    "        break\n",
    "print('Final total sales=',sales)\n"
   ]
